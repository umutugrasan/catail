{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Catail",
  "version": "0.9.5",
  "identifier": "com.catail.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Umut Uğraşan",
    "shortDescription": "Sıralı ekran görüntüsü ve pano kuyruğu",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "Turkish"
        ],
        "startMenuFolder": "Catail"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwRTcyRURDQzAwQjE5OUIKUldTYkdRdkEzQzduZ0ladXNiWXlpWlZOQ0RCTTFlSDdjdE5pN1BZbGpHKzBEU3dIT2U5akRYY00K",
      "endpoints": [
        "https://github.com/umutugrasan/catail/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
